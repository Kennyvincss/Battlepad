# Frontend (Vercel → Project → Settings → Environment Variables). All are public by design.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# A dedicated mainnet RPC (Helius, Triton, QuickNode…). The public endpoint rate-limits browsers.
VITE_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Optional: BATTLE swap fee that funds battle treasuries (Jupiter platform fee).
# Fee in basis points (50 = 0.5%) and a wrapped-SOL token account you own.
VITE_PLATFORM_FEE_BPS=0
VITE_FEE_ACCOUNT=
# Optional launch fee shown on the Launch page (USD, paid in SOL). 0 = free launches.
# Must match LAUNCH_FEE_USD on the launch-token function.
VITE_LAUNCH_FEE_USD=0
